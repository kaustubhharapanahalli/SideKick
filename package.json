{
  "name": "sidekick-ai",
  "version": "2.0.0",
  "description": "Your AI-powered study companion for YouTube videos and articles.",
  "private": true,
  "scripts": {
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "node scripts/lint-check.js",
    "package": "node scripts/package.js"
  },
  "keywords": ["chrome-extension", "sidekick", "gemini-ai", "education", "study-tutor"],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.2",
    "jsdom": "^29.1.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": ["**/tests/**/*.test.js"],
    "moduleFileExtensions": ["js", "json"],
    "collectCoverageFrom": [
      "scripts/**/*.js",
      "!scripts/lint-check.js",
      "!scripts/package.js"
    ]
  }
}
